# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=legaldb
POSTGRES_USER=legaluser
POSTGRES_PASSWORD=legalpass

# Used by the backend (async driver for FastAPI, sync driver for Alembic)
DATABASE_URL=postgresql+asyncpg://legaluser:legalpass@localhost:5432/legaldb
DATABASE_URL_SYNC=postgresql://legaluser:legalpass@localhost:5432/legaldb

# ─── Embeddings / LLM ───────────────────────────────────────────────────────
# Leave blank to use the local fallback (TF-IDF / hash-based) embedding.
# Set to an OpenAI key to use text-embedding-3-small + gpt-4o for /ask.
OPENAI_API_KEY=

# Override the model names if needed
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o

# ─── OCR (Tesseract) ────────────────────────────────────────────────────────
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Docker:    tesseract
TESSERACT_CMD=tesseract
OCR_LANG=spa

# ─── App ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
